# Email Configuration - Recipient
CONTACT_TO_EMAIL=your-email@example.com

# Email Provider - SMTP (Hostinger, Gmail, etc.)
# Required if using SMTP for email delivery
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-app-password
CONTACT_FROM_EMAIL=Portfolio <noreply@yourdomain.com>

# Email Provider - Resend (fallback if SMTP is not configured)
# API key from https://resend.com
RESEND_API_KEY=your_resend_api_key

# Cloudflare Turnstile (optional - for form spam protection)
# Leave blank to disable. Get keys from https://dash.cloudflare.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Deployment Health Check (optional - for monitoring email delivery)
# Generate a secure random token for authentication
DEPLOY_HEALTH_TOKEN=generate_a_random_secure_token_here

# Site URL (optional - overrides the default from site.config.ts)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Vercel KV (Redis) - auto-injected by Vercel for visitor counter
# Leave commented out for local development
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
